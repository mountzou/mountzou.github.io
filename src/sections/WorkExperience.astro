---
import CardTitle from "../components/CardTitle.astro";
import SectionTitle from "../components/SectionTitle.astro";
import BadgeDate from "../components/BadgeDateRange.astro";
import { workExperienceItems } from "../lib/portfolio";

---

{workExperienceItems.length > 0 && (
  <section id="work-experience" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-6 text-slate-950">
    <div>
      <SectionTitle title="Work Experience" />

      <div>
        {workExperienceItems.map((item) => {
          const { role, dateRange, organization, project, description } = item;
          const { highlights, locationType, relationshipType } = item;

          const metaBadges = [locationType, relationshipType].filter(Boolean);

          return (
            <div>
              <div>
                <BadgeDate label={dateRange} />
                <CardTitle title={role} />

                {organization && (
                  <p>{organization}</p>
                )}

                {project && (
                  <p>
                    {project}
                  </p>
                )}

                {description && (
                  <p>{description}</p>
                )}

                {highlights.length > 0 && (
                  <ul>
                    {highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}

                {metaBadges.length > 0 && (
                  <div>
                    {metaBadges.map((badge) => (
                      <span>
                        {badge}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div>
                <div>
                  <CardTitle title={role} />

                  <div>
                    {dateRange && <BadgeDate label={dateRange} />}

                    {metaBadges.map((badge) => (
                      <span>
                        {badge}
                      </span>
                    ))}
                  </div>
                </div>

                {project && (
                  <p>
                    {project}
                  </p>
                )}

                {organization && (
                  <p>{organization}</p>
                )}

                {description && (
                  <p>{description}</p>
                )}

                {highlights.length > 0 && (
                  <ul>
                    {highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
