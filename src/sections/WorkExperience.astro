---
import CardTitle from "../components/CardTitle.astro";
import SectionTitle from "../components/SectionTitle.astro";
import BadgeDate from "../components/BadgeDateRange.astro";

import workData from "../content/work-experience.json";

const { items } = workData;

const hasText = (value) => typeof value === "string" && value.trim() !== "";

const itemsWithRole = items.filter((item) => hasText(item.role));
---

{itemsWithRole.length > 0 && (
  <section id="work-experience" class="scroll-mt-20 py-6">
    <div class="mx-auto max-w-6xl px-4">
      <SectionTitle title="Work Experience" />

      <div class="space-y-4 font-light text-muted-foreground">
        {itemsWithRole.map((item) => {
          const role = hasText(item.role) ? item.role.trim() : "";
          const dateRange = hasText(item.dateRange) ? item.dateRange.trim() : "";
          const organization = hasText(item.organization) ? item.organization.trim() : "";
          const project = hasText(item.project) ? item.project.trim() : "";
          const description = hasText(item.description) ? item.description.trim() : "";
          const locationType = hasText(item.locationType) ? item.locationType.trim() : "";
          const relationshipType = hasText(item.relationshipType) ? item.relationshipType.trim() : "";

          const highlights = Array.isArray(item.highlights)
            ? item.highlights.filter((h) => hasText(h)).map((h) => h.trim())
            : [];

          const metaBadges = [locationType, relationshipType].filter(Boolean);

          return (
            <div class="rounded-lg bg-gray-50 p-4">
              <div class="space-y-2 leading-loose md:hidden">
                <BadgeDate label={dateRange} />
                <CardTitle title={role} />

                {organization && (
                  <p class="mt-1 text-sm text-muted-foreground">{organization}</p>
                )}

                {project && (
                  <p class="mt-2 text-sm font-medium text-muted-foreground">
                    {project}
                  </p>
                )}

                {description && (
                  <p class="mt-2 text-sm text-muted-foreground">{description}</p>
                )}

                {highlights.length > 0 && (
                  <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm">
                    {highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}

                {metaBadges.length > 0 && (
                  <div class="mt-3 flex flex-wrap justify-end gap-2 pt-3">
                    {metaBadges.map((badge) => (
                      <span class="inline-flex items-center rounded-md bg-muted px-2.5 py-1 font-mono text-[12px] font-medium text-muted-foreground">
                        {badge}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="hidden md:block">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <CardTitle title={role} />

                  <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
                    {dateRange && <BadgeDate label={dateRange} />}

                    {metaBadges.map((badge) => (
                      <span class="inline-flex items-center rounded-md bg-muted px-2.5 py-1 font-mono text-[12px] font-medium text-muted-foreground">
                        {badge}
                      </span>
                    ))}
                  </div>
                </div>

                {project && (
                  <p class="mt-2 text-sm font-medium text-muted-foreground">
                    {project}
                  </p>
                )}

                {organization && (
                  <p class="mt-2 text-sm text-muted-foreground">{organization}</p>
                )}

                {description && (
                  <p class="mt-2 text-sm text-muted-foreground">{description}</p>
                )}

                {highlights.length > 0 && (
                  <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm">
                    {highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}