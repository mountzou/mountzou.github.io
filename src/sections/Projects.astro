---
import projectsData from '../content/projects.json';
const { items } = projectsData;
const itemsWithTitle = items.filter((item) => item.title && String(item.title).trim() !== '');
---

{itemsWithTitle.length > 0 && (
<section id="projects" class="py-6 md:py-10 scroll-mt-20">
  <div class="container mx-auto px-4 max-w-6xl">
    <h2 class="text-4xl font-semibold tracking-tight text-foreground mb-8 border-b border-border pb-2">
      Projects
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-muted-foreground">
      {itemsWithTitle.map((item) => (
        <div class="rounded-lg border border-border bg-gray-50 p-4">
          <p class="text-lg font-medium text-foreground tracking-tight leading-relaxed">{item.title}</p>
          <p class="text-sm mt-2">{item.description}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <span class="rounded-md bg-muted px-2 py-0.5 text-xs">{tag}</span>
            ))}
            {item.url && (
              <a href={item.url} class="text-sm text-primary underline hover:no-underline" target="_blank" rel="noopener noreferrer">
                View →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
