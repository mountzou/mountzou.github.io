---
import CardTitle from "../components/CardTitle.astro";
import SectionTitle from "../components/SectionTitle.astro";

import conferencesData from "../content/conferences.json";

const { items, highlightAuthor = "" } = conferencesData;

const itemsWithTitle = items.filter(
  (item) => item.title && String(item.title).trim() !== ""
);

const sortedItems = [...itemsWithTitle].sort(
  (a, b) => Number(b.year) - Number(a.year)
);

function hasText(value: unknown) {
  return typeof value === "string" && value.trim() !== "";
}

function getAuthorSegments(authorsStr: string, highlightName: string) {
  if (!highlightName?.trim()) {
    return [{ name: authorsStr, highlight: false }];
  }

  const lastName = highlightName.trim().split(/\s+/).pop() ?? "";

  return authorsStr
    .split(",")
    .map((s) => s.trim())
    .map((name) => ({
      name,
      highlight: Boolean(lastName) && name.includes(lastName),
    }));
}
---

{sortedItems.length > 0 && (
  <section id="conferences" class="scroll-mt-20 py-6">
    <div class="container mx-auto max-w-6xl px-4">
      <SectionTitle title="Conferences" />

      <div class="grid grid-cols-1 gap-6 font-light text-muted-foreground lg:grid-cols-3">
        {sortedItems.map((item) => {
          const authors = hasText(item.authors) ? item.authors.trim() : "";
          const conferenceLine = [
            item.conferenceName,
            item.conferenceLocation,
            item.conferenceDate,
          ]
            .filter((value) => typeof value === "string" && value.trim() !== "")
            .join(" · ");

          return (
            <div class="flex h-full flex-col rounded-lg bg-card p-4">
              <CardTitle title={item.title} />

              <div class="mt-auto pt-4">
                {authors && (
                  <p class="text-sm">
                    {getAuthorSegments(authors, highlightAuthor).map((seg, i) => (
                      <>
                        {i > 0 ? ", " : ""}
                        {seg.highlight ? (
                          <span class="underline">{seg.name}</span>
                        ) : (
                          seg.name
                        )}
                      </>
                    ))}
                  </p>
                )}

                {conferenceLine && (
                  <p class="mt-2 text-sm">
                    {conferenceLine}
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}