---
import CardTitle from "../components/CardTitle.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { conferenceHighlightAuthor, conferenceItems } from "../lib/portfolio";

function getAuthorSegments(authorsStr: string, highlightName: string) {
  if (!highlightName?.trim()) {
    return [{ name: authorsStr, highlight: false }];
  }

  const lastName = highlightName.trim().split(/\s+/).pop() ?? "";

  return authorsStr
    .split(",")
    .map((s) => s.trim())
    .map((name) => ({
      name,
      highlight: Boolean(lastName) && name.includes(lastName),
    }));
}
---

{conferenceItems.length > 0 && (
  <section id="conferences" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-6 text-slate-950">
    <div>
      <SectionTitle title="Conferences" />

      <div>
        {conferenceItems.map((item) => {
          const authors = item.authors;
          const conferenceLine = [
            item.conferenceName,
            item.conferenceLocation,
            item.conferenceDate,
          ]
            .filter(Boolean)
            .join(" · ");

          return (
            <div>
              <CardTitle title={item.title} />

              <div>
                {authors && (
                  <p>
                    {getAuthorSegments(authors, conferenceHighlightAuthor).map((seg, i) => (
                      <>
                        {i > 0 ? ", " : ""}
                        {seg.highlight ? (
                          <span>{seg.name}</span>
                        ) : (
                          seg.name
                        )}
                      </>
                    ))}
                  </p>
                )}

                {conferenceLine && (
                  <p>
                    {conferenceLine}
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
