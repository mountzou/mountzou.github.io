---
import CardTitle from "../components/CardTitle.astro";
import SectionTitle from "../components/SectionTitle.astro";
import BadgeDate from "../components/BadgeDateRange.astro";
import { educationItems } from "../lib/portfolio";
---

{educationItems.length > 0 && (
  <section id="education" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-6 text-slate-950">
    <div>
      <SectionTitle title="Education" />

      <div>
        {educationItems.map((item) => {
          const departmentSchool = [item.department, item.school]
            .filter(Boolean)
            .join(", ");

          const universityLocation = [item.university, item.location]
            .filter(Boolean)
            .join(" — ");

          return (
            <div>
              <div>
                <BadgeDate label={item.dateRange} />
                <CardTitle title={item.degree} />

                {departmentSchool && (
                  <p>{departmentSchool}</p>
                )}

                {universityLocation && (
                  <p>{universityLocation}</p>
                )}
              </div>

              <div>
                <div>
                  <CardTitle title={item.degree} />
                  <BadgeDate label={item.dateRange} />
                </div>

                {departmentSchool && (
                  <p>
                    {departmentSchool}
                  </p>
                )}

                {universityLocation && (
                  <p>
                    {universityLocation}
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
