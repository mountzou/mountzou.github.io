---
import CardTitle from "../components/CardTitle.astro";
import SectionTitle from "../components/SectionTitle.astro";
import BadgeDate from "../components/BadgeDateRange.astro";

import educationData from "../content/education.json";

const { items } = educationData;

const hasText = (value) => typeof value === "string" && value.trim() !== "";

const itemsWithDegree = items.filter((item) => hasText(item.degree));
---

{itemsWithDegree.length > 0 && (
  <section id="education" class="scroll-mt-20 py-6">
    <div class="mx-auto max-w-6xl px-4">
      <SectionTitle title="Education" />

      <div class="space-y-4 font-light text-muted-foreground">
        {itemsWithDegree.map((item) => {
          const departmentSchool = [item.department, item.school]
            .filter((value) => typeof value === "string" && value.trim() !== "")
            .join(", ");

          const universityLocation = [item.university, item.location]
            .filter((value) => typeof value === "string" && value.trim() !== "")
            .join(" — ");

          return (
            <div class="rounded-lg bg-card p-4">
              <div class="space-y-2 leading-loose md:hidden">
                <BadgeDate label={item.dateRange} />
                <CardTitle title={item.degree} />

                {departmentSchool && (
                  <p class="text-sm text-muted-foreground">{departmentSchool}</p>
                )}

                {universityLocation && (
                  <p class="text-sm text-muted-foreground">{universityLocation}</p>
                )}
              </div>

              <div class="hidden md:block">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <CardTitle title={item.degree} />
                  <BadgeDate label={item.dateRange} />
                </div>

                {departmentSchool && (
                  <p class="mt-2 text-sm text-muted-foreground">
                    {departmentSchool}
                  </p>
                )}

                {universityLocation && (
                  <p class="mt-2 text-sm text-muted-foreground">
                    {universityLocation}
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}