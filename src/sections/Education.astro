---
import educationData from '../content/education.json';
const { items } = educationData;
const itemsWithDegree = items.filter((item) => item.degree && String(item.degree).trim() !== '');
---

{itemsWithDegree.length > 0 && (
<section id="education" class="py-6 md:py-10 scroll-mt-20">
  <div class="container mx-auto px-4 max-w-6xl">
    <h2 class="text-4xl font-bold tracking-tight text-foreground mb-8 border-b border-border pb-2">
      Education
    </h2>
    <div class="space-y-4 text-muted-foreground">
      {itemsWithDegree.map((item) => (
        <div class="rounded-lg bg-gray-50 p-4">
          <!-- Mobile: one row per field, no school -->
          <div class="md:hidden space-y-2">
            <p class="text-lg font-medium text-foreground tracking-tight leading-relaxed">{item.degree}</p>
            <span class="inline-flex items-center gap-1.5 rounded-md bg-muted px-2.5 py-1 text-xs font-medium font-mono text-muted-foreground">
              <svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {item.dateRange}
            </span>
            {item.department && (
              <p class="text-sm text-muted-foreground">{item.department}</p>
            )}
            <p class="text-sm text-muted-foreground">{item.university}</p>
            <p class="text-sm text-muted-foreground">{item.location}</p>
          </div>
          <!-- Desktop: original styling -->
          <div class="hidden md:block">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <p class="text-lg font-medium text-foreground tracking-tight leading-relaxed">{item.degree}</p>
              <span class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-muted px-2.5 py-1 text-xs font-medium font-mono text-muted-foreground">
              <svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {item.dateRange}
            </span>
            </div>
            {(item.department || item.school) && (
              <p class="text-sm mt-2 text-muted-foreground">
                {[item.department, item.school].filter(Boolean).join(' · ')}
              </p>
            )}
            <p class="text-sm mt-2 text-muted-foreground">{item.university} · {item.location}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
