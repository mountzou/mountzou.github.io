---
import CardTitle from "../components/CardTitle.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { articleHighlightAuthor, articleItems } from "../lib/portfolio";

function hasText(value: unknown) {
  return typeof value === "string" && value.trim() !== "";
}

function getAuthorSegments(authorsStr: string, highlightName: string) {
  if (!highlightName?.trim()) return [{ name: authorsStr, highlight: false }];

  const lastName = highlightName.trim().split(/\s+/).pop() ?? "";

  return authorsStr
    .split(",")
    .map((s) => s.trim())
    .map((name) => ({
      name,
      highlight: Boolean(lastName) && name.includes(lastName),
    }));
}
---

{articleItems.length > 0 && (
  <section id="articles" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-6 text-slate-950">
    <div>
      <SectionTitle title="Articles" />

      <div>
        {articleItems.map((item) => {
          const authors = item.authors;

          const journalLine = [
            item.journal,
            item.publisher,
          ]
            .filter(Boolean)
            .join(", ");

          const specialIssue = item.specialIssue;

          return (
            <div>
              <div>
                <div>
                  <span>
                    Year: {item.year}
                  </span>

                  {item.impactFactor && (
                    <span>
                      IF: {item.impactFactor}
                    </span>
                  )}

                  {item.quartile && (
                    <span>
                      Q: {item.quartile}
                    </span>
                  )}
                </div>

                <div>
                  {item.url ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <CardTitle title={item.title} />
                    </a>
                  ) : (
                    <CardTitle title={item.title} />
                  )}
                </div>

                <div>
                  {authors && (
                    <p>
                      {getAuthorSegments(authors, articleHighlightAuthor).map((seg, i) => (
                        <>
                          {i > 0 ? ", " : ""}
                          {seg.highlight ? (
                            <span>{seg.name}</span>
                          ) : (
                            seg.name
                          )}
                        </>
                      ))}
                    </p>
                  )}

                  {(journalLine || specialIssue) && (
                    <div>
                      <p>
                        {journalLine && (
                          <span>
                            {journalLine}
                          </span>
                        )}
                        {specialIssue && `, Special Issue: ${specialIssue}`}
                      </p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
