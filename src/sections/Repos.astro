---
import SectionTitle from "../components/SectionTitle.astro";
import { repoItems, repoOwner } from "../lib/portfolio";

const displayName = (name: string) => (repoOwner ? `${repoOwner}/${name}` : name);
---

{repoItems.length > 0 && (
<section id="repos" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-6 text-slate-950">
  <div>

    <SectionTitle title='Repos' />
    
    <div>
      {repoItems.map((repo) => (
        <a
          href={repo.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div>
            <div>
              <h3>
                {displayName(repo.name)}
              </h3>
              {repo.description && (
                <p>
                  {repo.description}
                </p>
              )}
              <div>
                <span>
                  {repo.language}
                </span>
                <span>
                  Stars: {repo.stars.toLocaleString()}
                </span>
                <span>
                  Forks: {repo.forks.toLocaleString()}
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}
