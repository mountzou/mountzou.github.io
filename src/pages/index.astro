          function updateConferenceShownCount(grid: HTMLElement, countEl: HTMLElement) {
            const total = Number(countEl.dataset.total) || grid.children.length;
            const shown = [...grid.children].filter((item) => !item.classList.contains('hidden')).length;
            countEl.textContent = `${shown} of ${total} shown`;
          }

          function equalizeConferenceRows(grid: HTMLElement, selector: string) {
            const elements = [...grid.querySelectorAll<HTMLElement>(selector)];

            elements.forEach((element) => {
              element.style.minHeight = '';
            });

            const visibleElements = elements.filter((element) => {
              const card = element.closest('article');
              return card instanceof HTMLElement && !card.classList.contains('hidden');
            });

            const rowGroups = new Map<number, HTMLElement[]>();

            visibleElements.forEach((element) => {
              const card = element.closest('article');
              if (!(card instanceof HTMLElement)) return;

              const rowTop = Math.round(card.getBoundingClientRect().top);
              rowGroups.set(rowTop, [...(rowGroups.get(rowTop) ?? []), element]);
            });

            rowGroups.forEach((rowElements) => {
              const maxHeight = Math.max(...rowElements.map((element) => element.getBoundingClientRect().height));
              rowElements.forEach((element) => {
                element.style.minHeight = `${Math.ceil(maxHeight)}px`;
              });
            });
          }

          function equalizeConferenceCardRows(grid: HTMLElement) {
            equalizeConferenceRows(grid, '[data-conference-title]');
            equalizeConferenceRows(grid, '[data-conference-authors]');
          }

          function applyConferenceToolbar(
            grid: HTMLElement,
            countEl: HTMLElement,
            sortBy: string,
            sortDirection: 'asc' | 'desc',
            activeFilters: string[],
