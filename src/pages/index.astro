              applyConferenceToolbar(
                grid,
                countEl,
                activeSort,
                getConferenceSortDirection(sortButtons, activeSort),
                activeFilters,
              );
              return;
            }

            let activeSort = 'year';
            const activeFilters = new Set<string>();

            sortButtons.forEach((button) => {
              button.addEventListener('click', () => {
                const sortBy = button.dataset.conferenceSort;
                if (!sortBy) return;

                const isAlreadyActive = activeSort === sortBy;

                if (isAlreadyActive) {
                  const nextDirection = button.dataset.sortDirection === 'asc' ? 'desc' : 'asc';
                  button.dataset.sortDirection = nextDirection;
                  updateConferenceSortButtonLabel(button);
                  applyConferenceToolbar(grid, countEl, activeSort, nextDirection, [...activeFilters]);
                  return;
                }

                activeSort = sortBy;
                sortButtons.forEach((sortButton) => {
                  setConferenceToolbarButtonState(sortButton, sortButton.dataset.conferenceSort === sortBy);
                });
                applyConferenceToolbar(
                  grid,
                  countEl,
                  activeSort,
                  getConferenceSortDirection(sortButtons, activeSort),
                  [...activeFilters],
                );
              });
            });

            filterButtons.forEach((button) => {
              button.addEventListener('click', () => {
                const filter = button.dataset.conferenceFilter;
                if (!filter) return;

                if (activeFilters.has(filter)) {
