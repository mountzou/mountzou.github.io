---
import Main from '../layouts/main.astro';
import Hero from '../components/Hero.astro';
import Education from '../sections/Education.astro';
import WorkExperience from '../sections/WorkExperience.astro';
import Projects from '../sections/Projects.astro';
import Articles from '../sections/Articles.astro';
import Conferences from '../sections/Conferences.astro';
import Repos from '../sections/Repos.astro';
---

<Main>
  <main>

    {/* Render the header section */}
    <header class="py-6 md:py-10 border-b border-border">
      <Hero />
    </header>

    {/* Render the `Education` section */}
    <Education />

    {/* Render the `WorkExperience` section */}
    <WorkExperience />

    {/* Render the `Projects` section */}
    <Projects />

    {/* Render the `Repos` section */}
    <Repos />

    {/* Render the `Articles` section */}
    <Articles />

    {/* Render the `Conferences` section */}
    <Conferences />

  </main>
</Main>
