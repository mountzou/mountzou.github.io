---
import '../styles/global.css';
import Main from '../layouts/main.astro';
import Education from '../sections/Education.astro';
import WorkExperience from '../sections/WorkExperience.astro';
import Projects from '../sections/Projects.astro';
import Articles from '../sections/Articles.astro';
import Conferences from '../sections/Conferences.astro';
import Repos from '../sections/Repos.astro';
---

<Main content={{ title: 'Chris Mountzouris' }}>
  <main>
    <header class="py-6 md:py-10 border-b border-border">
      <div class="container mx-auto px-4 max-w-6xl text-center">
        <h1 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">
          Chris Mountzouris
        </h1>
        <p class="mt-4 text-muted-foreground">
          Portfolio
        </p>
      </div>
    </header>

    <Education />
    <WorkExperience />
    <Projects />
    <Repos />
    <Articles />
    <Conferences />
  </main>
</Main>
