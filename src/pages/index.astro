          let conferenceToolbarReady = false;

          function setConferenceToolbarButtonState(button: HTMLButtonElement, isActive: boolean) {
            button.setAttribute('aria-pressed', String(isActive));
            button.classList.toggle('article-toolbar-btn--active', isActive);
          }

          function conferenceMatchesFilters(item: HTMLElement, activeFilters: string[]) {
            if (activeFilters.length === 0) return true;

            return activeFilters.every((filter) => {
              if (filter === 'firstAuthor') return item.dataset.firstAuthor === 'true';
              if (filter === 'greece') return item.dataset.greece === 'true';
              if (filter === 'ieee') return item.dataset.ieee === 'true';
              return true;
            });
          }

          function compareConferences(
            a: HTMLElement,
            b: HTMLElement,
            sortBy: string,
            direction: 'asc' | 'desc',
          ) {
            let result = 0;

            if (sortBy === 'citations') {
              result = Number(b.dataset.citations) - Number(a.dataset.citations);
            } else if (sortBy === 'date') {
              result = Number(b.dataset.date) - Number(a.dataset.date);
            } else {
              result = Number(b.dataset.year) - Number(a.dataset.year);
            }

            return direction === 'asc' ? -result : result;
