                applyConferenceToolbar(
                  grid,
                  countEl,
                  activeSort,
                  getConferenceSortDirection(sortButtons, activeSort),
                  [...activeFilters],
                );
              });
            });

            window.addEventListener('resize', () => {
              requestAnimationFrame(() => equalizeConferenceCardRows(grid));
            });

            document.fonts?.ready.then(() => {
              equalizeConferenceCardRows(grid);
            });

            conferenceToolbarReady = true;
            applyConferenceToolbar(
              grid,
              countEl,
              activeSort,
              getConferenceSortDirection(sortButtons, activeSort),
              [...activeFilters],
            );
          }

          initConferenceToolbar();
          document.addEventListener('astro:page-load', initConferenceToolbar);
        </script>
      </section>
