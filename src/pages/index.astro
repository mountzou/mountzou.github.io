            border-color: rgb(217 119 6 / 0.55);
            background-color: rgb(255 251 235);
            color: rgb(180 83 9);
          }
        </style>

        <script>
          let articleToolbarReady = false;

          function setArticleToolbarButtonState(button: HTMLButtonElement, isActive: boolean) {
            button.setAttribute('aria-pressed', String(isActive));
            button.classList.toggle('article-toolbar-btn--active', isActive);
          }

          function articleMatchesFilters(article: HTMLElement, activeFilters: string[]) {
            if (activeFilters.length === 0) return true;

            return activeFilters.every((filter) => {
              if (filter === 'q1') return article.dataset.quartile === 'Q1';
              if (filter === 'openAccess') return article.dataset.openAccess === 'true';
              if (filter === 'specialIssue') return article.dataset.specialIssue === 'true';
              if (filter === 'firstAuthor') return article.dataset.firstAuthor === 'true';
              return true;
            });
          }

          function compareArticles(
            a: HTMLElement,
            b: HTMLElement,
            sortBy: string,
            direction: 'asc' | 'desc',
          ) {
            let result = 0;

            if (sortBy === 'citations') {
              result = Number(b.dataset.citations) - Number(a.dataset.citations);
            } else if (sortBy === 'impactFactor') {
              result = Number(b.dataset.impactFactor) - Number(a.dataset.impactFactor);
            } else {
              result = Number(b.dataset.year) - Number(a.dataset.year);
            }

            return direction === 'asc' ? -result : result;
          }

          function updateSortButtonLabel(button: HTMLButtonElement) {
            const label = button.dataset.sortLabel;
            const direction = button.dataset.sortDirection === 'asc' ? 'asc' : 'desc';
            if (!label) return;

            button.textContent = `${label} ${direction === 'desc' ? '↓' : '↑'}`;
          }

          function getSortDirection(buttons: HTMLButtonElement[], sortBy: string) {
            const button = buttons.find((item) => item.dataset.articleSort === sortBy);
            return button?.dataset.sortDirection === 'asc' ? 'asc' : 'desc';
          }

          function updateArticleRowNumbers(grid: HTMLElement) {
            const visibleArticles = [...grid.children].filter(
              (article) => !article.classList.contains('hidden'),
            ) as HTMLElement[];

            visibleArticles.forEach((article, index) => {
              const label = article.querySelector('[data-article-index]');
              if (label) {
                label.textContent = `PUB.${String(visibleArticles.length - index).padStart(2, '0')}`;
              }
            });
          }

          function updateArticleShownCount(grid: HTMLElement, countEl: HTMLElement) {
            const total = Number(countEl.dataset.total) || grid.children.length;
            const shown = [...grid.children].filter((article) => !article.classList.contains('hidden')).length;
            countEl.textContent = `${shown} of ${total} shown`;
          }

          function applyArticleToolbar(
            grid: HTMLElement,
            countEl: HTMLElement,
            sortBy: string,
            sortDirection: 'asc' | 'desc',
            activeFilters: string[],
          ) {
            const articles = [...grid.children] as HTMLElement[];

            articles.sort((a, b) => compareArticles(a, b, sortBy, sortDirection));
            articles.forEach((article) => grid.appendChild(article));

            articles.forEach((article) => {
              const visible = articleMatchesFilters(article, activeFilters);
              article.classList.toggle('hidden', !visible);
            });

            updateArticleRowNumbers(grid);
            updateArticleShownCount(grid, countEl);
          }

          function initArticleToolbar() {
            const grid = document.getElementById('articles-grid');
            const countEl = document.getElementById('articles-shown-count');
            const sortButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-article-sort]')];
            const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-article-filter]')];

            if (!grid || !countEl || sortButtons.length === 0) return;

            if (articleToolbarReady) {
              const activeSort =
                sortButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.articleSort ?? 'year';
              const activeFilters = filterButtons
                .filter((button) => button.getAttribute('aria-pressed') === 'true')
                .map((button) => button.dataset.articleFilter)
                .filter((filter): filter is string => Boolean(filter));

              applyArticleToolbar(
                grid,
                countEl,
                activeSort,
                getSortDirection(sortButtons, activeSort),
                activeFilters,
              );
              return;
            }

            let activeSort = 'year';
            const activeFilters = new Set<string>();

            sortButtons.forEach((button) => {
              button.addEventListener('click', () => {
                const sortBy = button.dataset.articleSort;
                if (!sortBy) return;

                const isAlreadyActive = activeSort === sortBy;

                if (isAlreadyActive) {
                  const nextDirection = button.dataset.sortDirection === 'asc' ? 'desc' : 'asc';
                  button.dataset.sortDirection = nextDirection;
                  updateSortButtonLabel(button);
                  applyArticleToolbar(grid, countEl, activeSort, nextDirection, [...activeFilters]);
                  return;
                }

                activeSort = sortBy;
                sortButtons.forEach((sortButton) => {
                  setArticleToolbarButtonState(sortButton, sortButton.dataset.articleSort === sortBy);
                });
                applyArticleToolbar(
                  grid,
                  countEl,
                  activeSort,
                  getSortDirection(sortButtons, activeSort),
                  [...activeFilters],
                );
              });
            });

            filterButtons.forEach((button) => {
              button.addEventListener('click', () => {
                const filter = button.dataset.articleFilter;
                if (!filter) return;

                if (activeFilters.has(filter)) {
                  activeFilters.delete(filter);
                  setArticleToolbarButtonState(button, false);
                } else {
                  activeFilters.add(filter);
                  setArticleToolbarButtonState(button, true);
                }

                applyArticleToolbar(
                  grid,
                  countEl,
                  activeSort,
                  getSortDirection(sortButtons, activeSort),
                  [...activeFilters],
                );
              });
            });

            articleToolbarReady = true;
            applyArticleToolbar(
              grid,
              countEl,
              activeSort,
              getSortDirection(sortButtons, activeSort),
              [...activeFilters],
            );
          }

          initArticleToolbar();
          document.addEventListener('astro:page-load', initArticleToolbar);
        </script>
      </section>
    )}

