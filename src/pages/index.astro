            const items = [...grid.children] as HTMLElement[];

            items.sort((a, b) => compareConferences(a, b, sortBy, sortDirection));
            items.forEach((item) => grid.appendChild(item));

            items.forEach((item) => {
              const visible = conferenceMatchesFilters(item, activeFilters);
              item.classList.toggle('hidden', !visible);
            });

            updateConferenceRowNumbers(grid);
            updateConferenceShownCount(grid, countEl);
            requestAnimationFrame(() => equalizeConferenceCardRows(grid));
