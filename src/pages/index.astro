              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col overflow-hidden rounded-[10px] border border-slate-200 bg-slate-50/80 no-underline transition duration-200 hover:border-amber-500"
            >
              <div class="flex items-center justify-between gap-2 border-b border-slate-200 px-4 py-3">
                <div class="flex min-w-0 items-center gap-2">
                  <span
                    class="size-2 shrink-0 rounded-full"
                    style={`background-color: ${repo.languageColor || '#94a3b8'}`}
                    aria-hidden="true"
                  ></span>
                  <span class="truncate font-mono text-sm font-semibold text-slate-950">
                    {repoOwner}/{repo.name}
                  </span>
                </div>
                <span
                  class={`inline-flex shrink-0 rounded-full px-2 py-0.5 text-[0.56rem] font-semibold uppercase tracking-[0.08em] ring-1 ring-inset ${repoStatusClass(repo.status)}`}
                >
                  {repoStatusLabel(repo.status)}
                </span>
              </div>

              <div class="flex flex-1 flex-col px-4 py-3">
                <p class="m-0 text-[0.82rem] font-light leading-relaxed text-slate-600">
                  {repo.description}
                </p>

                {repo.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {repo.tags.map((tag) => (
                      <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[0.62rem] text-slate-500">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 px-4 py-2.5 text-[0.68rem] text-slate-500">
                <span class="inline-flex items-center gap-1.5">
                  <span
                    class="size-1.5 rounded-full"
                    style={`background-color: ${repo.languageColor || '#94a3b8'}`}
                    aria-hidden="true"
                  ></span>
                  {repo.language}
                </span>

                {repo.license && (
                  <span class="inline-flex items-center gap-1">
                    <Icon icon={licenseIcon} ssr className="size-3 text-slate-400" aria-hidden="true" />
                    {repo.license}
                  </span>
                )}

                {repo.updatedAt && (
                  <span class="inline-flex items-center gap-1">
                    <Icon icon={dateIcon} ssr className="size-3 text-slate-400" aria-hidden="true" />
                    {repo.updatedAt}
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <Footer />
  </main>
</Main>
