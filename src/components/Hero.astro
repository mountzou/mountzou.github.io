---
// Hero.astro
interface Props {
  heading?: string;
  class?: string;
}

const {
  heading = "Hello, I’m Chris Mountzouris",
  class: className,
} = Astro.props;
---

<section class:list={["py-4", className]}>
  <div class="container p-4">
    <div class="flex flex-col items-center gap-6">

      <h3 class="max-w-3xl text-center text-4xl font-medium lg:text-5xl">
        {heading}
      </h3>

    </div>
  </div>
</section>