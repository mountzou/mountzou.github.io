---
// Hero.astro
interface Props {
  heading?: string;
  class?: string;
}

const {
  heading = "Hello, I’m Chris Mountzouris. This is my digital corner, where I share research and repositories.",
  class: className,
} = Astro.props;
---

<section class:list={["py-4", className]}>
  <div class="container p-4">
    <div class="flex flex-col items-center gap-6">

      <h3 class="max-w-3xl text-center text-4xl font-medium lg:text-5xl animate-heading">
        {heading}
      </h3>

    </div>
  </div>
</section>

<style>
  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.6); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateX(10px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .animate-heading {
    animation: fadeInUp 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>