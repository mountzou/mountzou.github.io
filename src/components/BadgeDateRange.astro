---
interface Props {
  label: string;
}

const { label } = Astro.props as Props;
---

<span class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-muted px-2.5 py-1 text-[12px] font-mono text-muted-foreground">
  <svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 002 2v12a2 2 0 002 2z"
    />
  </svg>
  {label}
</span>